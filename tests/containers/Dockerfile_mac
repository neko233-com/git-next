# macOS package/static-shell acceptance only: this image runs Linux, never Mach-O.
FROM debian@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN apt-get update && apt-get install --no-install-recommends -y bash && rm -rf /var/lib/apt/lists/*
WORKDIR /acceptance
ENV HOME=/tmp/home USERPROFILE=/tmp/home SSH_ROOT_PATH=/tmp/ssh GIT_NEXT_ROOT=/repo
ENTRYPOINT ["/usr/local/bin/git-next-tool", "mac-package-static"]
CMD ["--package", "/package", "--output", "/results/macos-package-static.json"]
