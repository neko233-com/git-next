{
  "schema_version": 1,
  "product": "git-next",
  "status": "experimental",
  "default_branch": "main",
  "external_git_fallback": false,
  "external_ssh_fallback": false,
  "complete_git_parity": false,
  "features": {
    "version_build_options_json": true,
    "clean_switch_checkout": true,
    "fast_forward_pull_merge": true,
    "network_push": true,
    "existing_http_helper_login": true,
    "config_scopes_multivars": true,
    "cli_config_and_repository_context": true,
    "lfs": false,
    "full_credential_helper_compatibility": false,
    "native_lfs_pointer_cache_filters": true,
    "native_lfs_https_batch_basic": true,
    "status_stat_cache_refresh": true,
    "native_status_porcelain_v1_subset": true,
    "native_status_porcelain_v2_subset": true,
    "native_status_ignored_subset": true,
    "native_status_long_subset": true,
    "native_status_branch_headers_subset": true,
    "native_submodule_status_subset": true,
    "status_file_directory_boundaries_subset": true,
    "native_index_path_consistency_subset": true,
    "native_diff_show_log_subset": true,
    "native_restore_reset_subset": true,
    "cross_platform_lf_defaults": true,
    "canonical_filtered_status": true,
    "filesystem_only_system_config_discovery": true,
    "managed_windows_gcm_subset": true,
    "native_two_parent_merge_subset": true,
    "native_merge_no_commit_subset": true,
    "commit_message_cleanup_subset": true,
    "required_repository_extension_negotiation": true
  },
  "replacement_blockers": [
    "Complete push refspec/hook/output parity and the receive-pack server command are not accepted",
    "Complete LFS transport/locking and real credential-helper/login compatibility are not accepted",
    "Complete merge/recovery semantics, rebase, stash, cherry-pick, revert and full diff are not accepted",
    "Complete Git CLI, IDE, hooks, signing, submodule and linked-worktree compatibility is not accepted",
    "Checkout requires a clean ordinary-file worktree; full checkout/pathspec and crash-recovery automation are not accepted"
  ],
  "performance": "Measure optimized binaries with tests/benchmark.py; no universal speedup claim"
}
