set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR ARM64)
if(NOT DEFINED ENV{GIT_NEXT_LLVM_MINGW_ROOT})
  message(FATAL_ERROR "GIT_NEXT_LLVM_MINGW_ROOT must identify the pinned isolated compiler SDK")
endif()
file(TO_CMAKE_PATH "$ENV{GIT_NEXT_LLVM_MINGW_ROOT}" GIT_NEXT_LLVM_SDK)
set(CMAKE_C_COMPILER "${GIT_NEXT_LLVM_SDK}/bin/aarch64-w64-mingw32-clang.exe")
set(CMAKE_CXX_COMPILER "${GIT_NEXT_LLVM_SDK}/bin/aarch64-w64-mingw32-clang++.exe")
set(CMAKE_RC_COMPILER "${GIT_NEXT_LLVM_SDK}/bin/aarch64-w64-mingw32-windres.exe")
set(CMAKE_AR "${GIT_NEXT_LLVM_SDK}/bin/llvm-ar.exe")
set(CMAKE_RANLIB "${GIT_NEXT_LLVM_SDK}/bin/llvm-ranlib.exe")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")
set(CMAKE_FIND_ROOT_PATH "${GIT_NEXT_LLVM_SDK}/aarch64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)
