<?xml version="1.0" encoding="utf-8"?>
<!-- Copyright 2026 git-next contributors. MIT license. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="git-next" Manufacturer="neko233-com" Language="1033"
           Version="$(MsiVersion)" ProductCode="$(ProductCode)" UpgradeCode="$(UpgradeCode)"
           Scope="$(PackageScope)" InstallerVersion="500" Compressed="yes">
    <MajorUpgrade Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer git-next version is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPCOMMENTS" Value="$(ProductDescription)" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/neko233-com/git-next" />
    <Property Id="GITNEXTLAYOUT" Value="git-default-v2" />
    <Property Id="OFFICIALGIT">
      <RegistrySearch Id="OfficialGitInstallation" Root="$(RegistryHive)" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Git_is1"
                      Name="InstallLocation" Type="raw" Bitness="always64" />
    </Property>
    <!-- The replacement authorization is passed on the msiexec command line by the verified
         bootstrap (`install.ps1`). It must NOT be marked Secure: a Secure property cannot be
         set from the command line during InstallExecuteSequence, and it is not carried from
         the client to the server for a managed per-machine install either, so the value would
         silently stay "0" and the launch condition below would block every install that has
         an official Git registered. A registry credential was rejected instead: the MSI
         installs before the takeover runs, so no credential could exist yet, and a leftover
         credential would keep authorizing later, unrelated installs. The bootstrap verifies
         from the verbose MSI log that the property really reached the installer. -->
    <Property Id="REPLACEGIT" Value="0" />
    <!-- git-default-v2 installs over the official Git directory. A registered official Git
         elsewhere must be migrated by the verified takeover first; the same directory is the
         intended target and is only accepted with an explicit replacement authorization. -->
    <Launch Condition="Installed OR NOT OFFICIALGIT OR REPLACEGIT = &quot;1&quot;"
            Message="A registered official Git installation exists. git-next replaces it only from the verified bootstrap that migrates and backs it up first." />
    <Property Id="PREVIOUSINSTALLFOLDER">
      <RegistrySearch Id="PreviousUserInstallRoot" Root="$(RegistryHive)" Key="Software\git-next\MSI\$(Platform)"
                      Name="InstallRoot" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="PREVIOUSLAYOUT">
      <RegistrySearch Id="PreviousInstallLayout" Root="$(RegistryHive)" Key="Software\git-next\MSI\$(Platform)"
                      Name="InstallationLayout" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="INSTALLFOLDER" Value="[PREVIOUSINSTALLFOLDER]" Before="CostFinalize"
                 Condition="PREVIOUSINSTALLFOLDER AND PREVIOUSLAYOUT = &quot;git-default-v2&quot; AND NOT INSTALLFOLDER" Sequence="both" />
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <Property Id="REBOOT" Value="ReallySuppress" />
    <?if $(InstallScope) = machine ?>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Git">
        <Directory Id="BINDIR" Name="bin" />
        <Directory Id="UPDATERDIR" Name="updater" />
        <Directory Id="PREVIEWDIR" Name="preview"><Directory Id="PREVIEWBINDIR" Name="bin" /></Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAROOT" Name="git-next">
        <Directory Id="UPDATESROOT" Name="updates"><Directory Id="UPDATESTATE" Name="$(Platform)" /></Directory>
        <Directory Id="CONFIGROOT" Name="config" />
        <Directory Id="COMPONENTSROOT" Name="components" />
        <Directory Id="MIGRATIONSROOT" Name="migrations" />
      </Directory>
    </StandardDirectory>
    <?else?>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDirectory" Name="Programs">
<Directory Id="INSTALLFOLDER" Name="Git">
        <Directory Id="BINDIR" Name="bin" />
        <Directory Id="UPDATERDIR" Name="updater" />
        <Directory Id="PREVIEWDIR" Name="preview">
          <Directory Id="PREVIEWBINDIR" Name="bin" />
        </Directory>
      </Directory>
      </Directory>
    </StandardDirectory>
    <?endif?>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuDirectory" Name="git-next ($(Platform))" />
    </StandardDirectory>
    <Component Id="UserIntegration" Directory="BINDIR" Guid="*">
      <RegistryValue Root="$(RegistryHive)" Key="Software\git-next\MSI\$(Platform)" Name="InstallRoot"
                     Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
      <RegistryValue Root="$(RegistryHive)" Key="Software\git-next\MSI\$(Platform)" Name="InstallationLayout"
                     Value="git-default-v2" Type="string" />
      <Environment Id="UserPath" Name="PATH" Value="[BINDIR]" Action="set"
                   Part="last" System="$(PathSystem)" Permanent="no" />
      <Shortcut Id="UpdateShortcut" Directory="StartMenuDirectory" Name="Update git-next"
                Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
                Arguments="-NoLogo -NoProfile -ExecutionPolicy Bypass -File &quot;[UPDATERDIR]update.ps1&quot; -Mode Apply"
                WorkingDirectory="UPDATERDIR" />
      <RemoveFolder Id="RemoveStartMenuDirectory" Directory="StartMenuDirectory" On="uninstall" />
      <RemoveFolder Id="RemoveBinDirectory" Directory="BINDIR" On="uninstall" />
      <RemoveFolder Id="RemoveUpdaterDirectory" Directory="UPDATERDIR" On="uninstall" />
      <RemoveFolder Id="RemovePreviewBinDirectory" Directory="PREVIEWBINDIR" On="uninstall" />
      <RemoveFolder Id="RemovePreviewDirectory" Directory="PREVIEWDIR" On="uninstall" />
      <RemoveFolder Id="RemoveInstallDirectory" Directory="INSTALLFOLDER" On="uninstall" />
    </Component>
    <Component Id="TerminalIntegrationV2" Directory="BINDIR" Guid="*">
      <RegistryValue Root="$(RegistryHive)" Key="Software\git-next\MSI\$(Platform)" Name="GpuiTerminalIntegration"
                     Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
      <?if $(TerminalHasArguments) = yes ?>
      <Shortcut Id="TerminalShortcut" Directory="StartMenuDirectory" Name="Git Terminal"
                Target="[INSTALLFOLDER]$(TerminalRelativePath)" Arguments="$(TerminalArguments)" WorkingDirectory="INSTALLFOLDER" />
      <?else ?>
      <Shortcut Id="TerminalShortcut" Directory="StartMenuDirectory" Name="Git Terminal"
                Target="[INSTALLFOLDER]$(TerminalRelativePath)" WorkingDirectory="INSTALLFOLDER" />
      <?endif ?>
      <RegistryValue Root="$(RegistryHive)" Key="Software\Classes\Directory\shell\git-next-terminal" Value="Open Git-Terminal Here" Type="string" />
      <RegistryValue Root="$(RegistryHive)" Key="Software\Classes\Directory\shell\git-next-terminal\command" Value="&quot;[INSTALLFOLDER]$(TerminalRelativePath)&quot; --cwd &quot;%1&quot;" Type="string" />
      <RegistryValue Root="$(RegistryHive)" Key="Software\Classes\Directory\Background\shell\git-next-terminal" Value="Open Git-Terminal Here" Type="string" />
      <RegistryValue Root="$(RegistryHive)" Key="Software\Classes\Directory\Background\shell\git-next-terminal\command" Value="&quot;[INSTALLFOLDER]$(TerminalRelativePath)&quot; --cwd &quot;%V&quot;" Type="string" />
    </Component>
    <?if $(InstallScope) = machine ?>
    <Component Id="MachineRootSecurity" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue Root="HKLM" Key="Software\git-next\MSI\$(Platform)" Name="Scope" Value="machine" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\git-next\MSI\$(Platform)" Name="ParentRoot" Value="[INSTALLFOLDER]" Type="string" />
      <CreateFolder><PermissionEx Sddl="O:BAG:BAD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" /></CreateFolder>
    </Component>
    <Component Id="MachineDataSecurity" Directory="DATAROOT" Guid="*" Permanent="yes">
      <RegistryValue Root="HKLM" Key="Software\git-next\State" Name="Root" Value="[DATAROOT]" Type="string" KeyPath="yes" />
      <CreateFolder><PermissionEx Sddl="O:BAG:BAD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" /></CreateFolder>
    </Component>
    <Component Id="MachineMigrationSecurity" Directory="MIGRATIONSROOT" Guid="*" Permanent="yes">
      <RegistryValue Root="HKLM" Key="Software\git-next\State" Name="Migrations" Value="[MIGRATIONSROOT]" Type="string" KeyPath="yes" />
      <CreateFolder><PermissionEx Sddl="O:BAG:BAD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" /></CreateFolder>
    </Component>
    <Component Id="MachineUpdateState" Directory="UPDATESTATE" Guid="*" Permanent="yes">
      <RegistryValue Root="HKLM" Key="Software\git-next\State\$(Platform)" Name="Updates" Value="[UPDATESTATE]" Type="string" KeyPath="yes" />
      <CreateFolder><PermissionEx Sddl="O:BAG:BAD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" /></CreateFolder>
    </Component>
    <Component Id="MachineConfigState" Directory="CONFIGROOT" Guid="*" Permanent="yes">
      <RegistryValue Root="HKLM" Key="Software\git-next\State" Name="Config" Value="[CONFIGROOT]" Type="string" KeyPath="yes" />
      <CreateFolder><PermissionEx Sddl="O:BAG:BAD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" /></CreateFolder>
    </Component>
    <Component Id="MachineComponentState" Directory="COMPONENTSROOT" Guid="*" Permanent="yes">
      <RegistryValue Root="HKLM" Key="Software\git-next\State" Name="Components" Value="[COMPONENTSROOT]" Type="string" KeyPath="yes" />
      <CreateFolder><PermissionEx Sddl="O:BAG:BAD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" /></CreateFolder>
    </Component>
    <?endif?>
    <CustomAction Id="RollbackRegisterUpdater" Directory="System64Folder" Execute="rollback" Impersonate="$(TaskImpersonate)" Return="check"
                  ExeCommand="&quot;[UPDATERDIR]msi-worker.exe&quot; -Mode RollbackRegistration" />
    <CustomAction Id="RegisterUpdater" Directory="System64Folder" Execute="deferred" Impersonate="$(TaskImpersonate)" Return="check"
                  ExeCommand="&quot;[UPDATERDIR]msi-worker.exe&quot; -Mode Register" />
    <CustomAction Id="RollbackRuntimeConfiguration" Directory="System64Folder" Execute="rollback" Impersonate="$(TaskImpersonate)" Return="check"
                  ExeCommand="&quot;[UPDATERDIR]msi-worker.exe&quot; -Mode RollbackRuntimeConfiguration" />
    <CustomAction Id="InitializeRuntimeConfiguration" Directory="System64Folder" Execute="deferred" Impersonate="$(TaskImpersonate)" Return="check"
                  ExeCommand="&quot;[UPDATERDIR]msi-worker.exe&quot; -Mode InitializeRuntimeConfiguration" />
    <CustomAction Id="CommitRuntimeConfiguration" Directory="System64Folder" Execute="commit" Impersonate="$(TaskImpersonate)" Return="ignore"
                  ExeCommand="&quot;[UPDATERDIR]msi-worker.exe&quot; -Mode CommitRuntimeConfiguration" />
    <CustomAction Id="RollbackUnregisterUpdater" Directory="System64Folder" Execute="rollback" Impersonate="$(TaskImpersonate)" Return="check"
                  ExeCommand="&quot;[UPDATERDIR]msi-worker.exe&quot; -Mode RollbackRegistration" />
    <CustomAction Id="UnregisterUpdater" Directory="System64Folder" Execute="deferred" Impersonate="$(TaskImpersonate)" Return="check"
                  ExeCommand="&quot;[UPDATERDIR]msi-worker.exe&quot; -Mode Unregister" />
    <CustomAction Id="GuardTakeoverUninstall" Directory="System64Folder" Execute="immediate" Impersonate="yes" Return="check"
                  ExeCommand="&quot;[UPDATERDIR]msi-worker.exe&quot; -Mode GuardRemoval" />
    <InstallExecuteSequence>
      <Custom Action="GuardTakeoverUninstall" Before="InstallInitialize" Condition="Installed AND REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RollbackRuntimeConfiguration" After="WriteRegistryValues" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="InitializeRuntimeConfiguration" After="RollbackRuntimeConfiguration" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="CommitRuntimeConfiguration" After="InitializeRuntimeConfiguration" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RollbackRegisterUpdater" After="CommitRuntimeConfiguration" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RegisterUpdater" After="RollbackRegisterUpdater" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RollbackUnregisterUpdater" Before="UnregisterUpdater" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="UnregisterUpdater" Before="RemoveRegistryValues" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
    <Feature Id="ProductFeature" Title="git-next" Level="1">
      <ComponentRef Id="UserIntegration" />
      <ComponentRef Id="TerminalIntegrationV2" />
      <?if $(InstallScope) = machine ?>
      <ComponentRef Id="MachineRootSecurity" /><ComponentRef Id="MachineDataSecurity" />
      <ComponentRef Id="MachineMigrationSecurity" /><ComponentRef Id="MachineUpdateState" />
      <ComponentRef Id="MachineConfigState" /><ComponentRef Id="MachineComponentState" />
      <?endif?>
      <ComponentGroupRef Id="Payload" />
    </Feature>
  </Package>
</Wix>
