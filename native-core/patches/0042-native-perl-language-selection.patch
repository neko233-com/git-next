+# Copyright 2026 git-next contributors. Native catalog bridge.
+sub __native_translation {
+	my ($count, $singular, $plural) = @_;
+	require File::Basename;
+	require File::Spec;
+	my $directory = File::Basename::dirname(__FILE__);
+	my $program = File::Spec->catfile($directory, '..', '..', '..', 'bin', 'git');
+	$program .= '.exe' if -f "$program.exe";
+	die "Required owned git-next translation core is missing" unless -x $program;
+	my @arguments = ('i18n--gettext');
+	push @arguments, '--plural', "$count" if defined $count;
+	push @arguments, '--', $singular;
+	push @arguments, $plural if defined $count;
+	local $ENV{MSYS2_ARG_CONV_EXCL} = '*';
+	open my $reader, '-|', $program, @arguments or die "Could not start owned git-next translation core";
+	local $/;
+	my $translated = <$reader> // '';
+	close $reader or die "Owned git-next translation core failed";
+	utf8::decode($translated) if utf8::is_utf8($singular);
+	return $translated;
+}
