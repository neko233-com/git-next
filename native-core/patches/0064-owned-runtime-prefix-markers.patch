 static const char *executable_dirname;
 
+static char *git_next_owned_prefix(const char *dirname, const char *suffix)
+{
+	char *candidate = strip_path_suffix(dirname, suffix);
+	struct strbuf marker = STRBUF_INIT;
+	int owned;
+
+	if (!candidate)
+		return NULL;
+	strbuf_addf(&marker, "%s/git-next-distribution.json", candidate);
+	owned = !access(marker.buf, F_OK);
+	if (!owned) {
+		strbuf_reset(&marker);
+		strbuf_addf(&marker, "%s/runtime/etc/gitconfig", candidate);
+		owned = !access(marker.buf, F_OK);
+	}
+	strbuf_release(&marker);
+	if (!owned)
+		FREE_AND_NULL(candidate);
+	return candidate;
+}
+
