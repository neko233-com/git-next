+	trace2_data_intmax("git-next", index->repo, "preload-thread-budget", budget);
+	threads = min(index->cache_nr / THREAD_COST, budget);
 	if ((index->cache_nr > 1) && (threads < 2) && git_env_bool("GIT_TEST_PRELOAD_INDEX", 0))
